PORT=3847
# Gmail pixel isteği internetten gelir — localhost çalışmaz. Sunucu IP/domain veya ngrok URL.
PUBLIC_BASE_URL=http://localhost:3847

# Panel kilidi. İkisi de dolu olmalı. Üretmek için: npm run keys
PANEL_PASSWORD=
AUTH_SECRET=
# Nginx arkasında: TRUST_PROXY=true
# İsteğe bağlı IP kapısı (yalnız panel; piksel/CV linki herkese açık kalır)
# ALLOWED_IPS=127.0.0.1,203.0.113.10

# İsteğe bağlı: nodemailer ile test maili
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=********@gmail.com
SMTP_PASS=********
MAIL_FROM=********@gmail.com
MAIL_FROM_NAME=Adın Soyadın
MAIL_TO=********@gmail.com

# İlk okunduğunda e-posta bildirimi (SMTP ayarları gerekli)
NOTIFY_TO=********@gmail.com
NOTIFY_WATCH_RECIPIENTS=*
# Belirli alıcılar: a@x.com,b@y.com — hepsi için * veya all
NOTIFY_FROM_NAME=MailPing
# NOTIFY_ON_READ=false ile kapatılır

# Gmail çekmek: SMTP_USER/SMTP_PASS Gmail uygulama şifresi ise IMAP ile gönderilenler gelir.
# Kullanıcı "Google ile bağla" için Cloud Console OAuth istemcisi:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3847/api/gmail/callback
